---
import Base from '../../layouts/Base.astro';
import { type Lang, langPaths, getDict, fill } from '../../i18n';
import { SITE } from '../../config';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = getDict(lang).support;
---
<Base lang={lang} page="support" title={c.title} description={c.description}>
  <div class="container prose">
    <h1>{c.title}</h1>
    <p>{c.lead}</p>
    <div class="card contact">
      <h2>{c.contactTitle}</h2>
      <p class="mail"><a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a></p>
      <p class="hint">{c.contactBody}</p>
    </div>
    <h2>{c.faqTitle}</h2>
    {c.faq.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p set:html={fill(item.a, lang)} />
      </details>
    ))}
  </div>
</Base>

<style>
  .contact h2 { margin-top: 0; }
  .contact .mail { margin: 0 0 .4rem; font-size: 1.1rem; }
  .contact .hint { margin: 0; color: var(--muted); font-size: .92rem; }
  details { border-bottom: 1px solid var(--line); padding: .9rem 0; }
  summary { cursor: pointer; color: var(--heading); font-weight: 600; }
  details p { margin: .7rem 0 0; }
</style>
