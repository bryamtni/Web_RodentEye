---
// Página obligatoria para Google Play: pedir el borrado sin tener la app instalada.
import LegalPage from '../../components/LegalPage.astro';
import { type Lang, langPaths, getDict } from '../../i18n';
import { SITE } from '../../config';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const doc = getDict(lang).deleteAccount;
const mailto = `mailto:${SITE.supportEmail}?subject=${encodeURIComponent(doc.emailSubject)}`;
---
<LegalPage lang={lang} page="delete-account" doc={doc}>
  <p class="cta"><a class="btn btn-primary" href={mailto}>{doc.button}</a></p>
</LegalPage>

<style>
  .cta { margin: 1.5rem 0 0; }
</style>
