---
import Base from '../../layouts/Base.astro';
import { type Lang, langPaths, getDict, url, asset } from '../../i18n';
import { SITE } from '../../config';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = getDict(lang);
const c = t.home;
// Capturas reales de la app (cuenta demo de App Review), de Docs/AppStoreScreenshots/iPhone_6.9
const screens = ['01_home', '02_camera_detail', '03_events'];
const stores = [
  { label: t.common.appStore, href: SITE.appStoreUrl },
  { label: t.common.googlePlay, href: SITE.playStoreUrl },
];
---
<Base lang={lang} page="" title={c.title} description={c.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.h1} <span class="accent">{c.h1Accent}</span></h1>
        <p class="lead">{c.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#download">{c.ctaPrimary}</a>
          <a class="btn btn-ghost" href="#how">{c.ctaSecondary}</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="ring"></div>
        <img src={asset('img/rodent-eye-mark.png')} width="160" height="160" alt="" />
      </div>
    </div>
  </section>

  <section id="how" class="section">
    <div class="container">
      <h2>{c.howTitle}</h2>
      <ol class="steps">
        {c.steps.map((s, i) => (
          <li class="card">
            <span class="num">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="screens" class="section">
    <div class="container">
      <h2>{c.screensTitle}</h2>
      <ul class="screens">
        {c.screens.map((sc, i) => (
          <li>
            <figure>
              <div class="phone">
                <img src={asset(`img/screens/${screens[i]}.webp`)} width="600" height="1304" alt={sc.caption} loading="lazy" decoding="async" />
              </div>
              <figcaption>{sc.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{c.featuresTitle}</h2>
      <ul class="features">
        {c.features.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="download" class="section">
    <div class="container">
      <div class="card download">
        <div>
          <h2>{c.downloadTitle}</h2>
          <p>{c.downloadLead}</p>
        </div>
        <div class="actions">
          {stores.map((s) => s.href
            ? <a class="btn btn-primary" href={s.href}>{s.label}</a>
            : <span class="btn btn-ghost" aria-disabled="true">{s.label} · {t.common.soon}</span>)}
        </div>
      </div>
      <p class="help"><a href={url(lang, 'support')}>{c.supportLink} {t.common.arrow}</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 56px; border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1.3fr 1fr; } }
  .accent { color: var(--link); }
  .lead { font-size: 1.12rem; max-width: 560px; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .hero-art { position: relative; display: grid; place-items: center; min-height: 260px; }
  /* Brillo verde centrado detrás del logo (antes iba en el fondo de toda la sección y en
     pantallas anchas quedaba lejos del logo). */
  .hero-art::before {
    content: ''; position: absolute; width: 560px; height: 560px; border-radius: 50%;
    background: radial-gradient(circle, var(--glow), transparent 65%);
  }
  .hero-art img { width: 160px; border-radius: 50%; position: relative; }
  .ring { position: absolute; width: 240px; height: 240px; border-radius: 50%;
    border: 1px solid var(--ring); box-shadow: 0 0 0 40px var(--ring-halo), 0 0 0 80px var(--ring-halo); }
  @media (prefers-reduced-motion: no-preference) {
    .ring { animation: pulse 3.2s ease-in-out infinite; }
    @keyframes pulse { 50% { transform: scale(1.06); opacity: .7; } }
  }
  .section { padding: 64px 0 0; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 640px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .num { font: 500 .85rem var(--font-mono); color: var(--link); display: block; margin-bottom: .8rem; }
  .steps p, .features p { margin: 0; }
  .screens {
    list-style: none; margin: 0; padding: 4px 0 12px; display: grid; gap: 24px;
    grid-template-columns: repeat(3, minmax(220px, 1fr)); justify-items: center;
  }
  .screens figure { margin: 0; text-align: center; }
  .phone {
    width: min(260px, 100%); padding: 8px; border-radius: 40px; background: #0d0d0d;
    box-shadow: 0 0 0 1px var(--line), var(--shadow); margin-inline: auto;
  }
  .phone img { width: 100%; height: auto; border-radius: 32px; }
  .screens figcaption { margin-top: 14px; color: var(--heading); font-weight: 600; }
  /* En celular las capturas se deslizan de lado en vez de apilarse. */
  @media (max-width: 760px) {
    .screens {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%;
      overflow-x: auto; scroll-snap-type: x mandatory; justify-items: stretch;
      margin-inline: -16px; padding-inline: 16px; scrollbar-width: none;
    }
    .screens::-webkit-scrollbar { display: none; }
    .screens li { scroll-snap-align: center; }
  }
  .features { list-style: none; padding: 0; margin: 0; display: grid; gap: 28px 32px; }
  @media (min-width: 640px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .features { grid-template-columns: repeat(3, 1fr); } }
  .features li { border-inline-start: 2px solid var(--rule); padding-inline-start: 1rem; }
  .features h3 { margin-bottom: .3em; }
  .download { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .download h2 { margin-bottom: .2em; }
  .download p { margin: 0; }
  .download .actions { margin-top: 0; }
  .help { margin-top: 1.25rem; }
</style>
