---
import Base from '../layouts/Base.astro';
import { getDict, url } from '../i18n';
const t = getDict('en').notFound;
const es = getDict('es').notFound;
---
<Base lang="en" page="404" title={t.title} description={t.body}>
  <div class="container prose">
    <h1>{t.title}</h1>
    <p>{t.body}</p>
    <p lang="es">{es.body}</p>
    <p><a class="btn btn-primary" href={url('en')}>{t.back}</a></p>
  </div>
</Base>
