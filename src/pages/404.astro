---
import Base from '../layouts/Base.astro';
import { t, url } from '../i18n/ui';
---
<Base lang="en" page="404" title={t('en', 'notfound.title')} description={t('en', 'notfound.body')}>
  <div class="container prose">
    <h1>{t('en', 'notfound.title')}</h1>
    <p>{t('en', 'notfound.body')}</p>
    <p lang="es">{t('es', 'notfound.body')}</p>
    <p><a class="btn btn-primary" href={url('en')}>{t('en', 'notfound.back')}</a></p>
  </div>
</Base>
