---
import Logo from './Logo.astro';
import { type Lang, languages, langCodes, getDict, url } from '../i18n';
interface Props { lang: Lang; page: string }
const { lang, page } = Astro.props;
const t = getDict(lang);
const links = [
  { page: 'support', label: t.nav.support },
  { page: 'privacy', label: t.nav.privacy },
];
---
<header class="site-header">
  <div class="container bar">
    <a href={url(lang)} class="home" aria-label={`Rodent Eye — ${t.nav.home}`}><Logo /></a>
    <nav aria-label={t.nav.home}>
      {links.map((l) => (
        <a href={url(lang, l.page)} data-page={l.page} aria-current={page === l.page ? 'page' : undefined}>{l.label}</a>
      ))}
      <button type="button" class="theme-toggle" aria-label={t.nav.theme} title={t.nav.theme}>
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <details class="lang">
        <summary aria-label={t.nav.language}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
          <span>{lang.toUpperCase()}</span>
        </summary>
        <ul>
          {langCodes.map((l) => (
            <li>
              <a href={url(l, page === '404' ? '' : page)} hreflang={languages[l].hreflang} lang={languages[l].hreflang}
                aria-current={l === lang ? 'true' : undefined}>{languages[l].name}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Cambia entre claro y oscuro y guarda la elección en este navegador.
  const root = document.documentElement;
  const darkQuery = matchMedia('(prefers-color-scheme: dark)');
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const isDark = root.dataset.theme ? root.dataset.theme === 'dark' : darkQuery.matches;
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: var(--header-bg);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .home { flex-shrink: 0; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; }
  .home { text-decoration: none; }
  nav { display: flex; align-items: center; gap: 1.1rem; font-size: .92rem; }
  nav > a { color: var(--text); text-decoration: none; }
  nav > a:hover, nav > a[aria-current='page'] { color: var(--heading); }
  .theme-toggle {
    display: grid; place-items: center; width: 34px; height: 30px; padding: 0; cursor: pointer;
    background: none; border: 1px solid var(--line); border-radius: 999px; color: var(--text);
  }
  .theme-toggle:hover { border-color: var(--link); color: var(--heading); }
  /* Muestra la luna en tema claro (pasar a oscuro) y el sol en tema oscuro. */
  .theme-toggle .sun { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun { display: block; }
    :global(:root:not([data-theme='light'])) .theme-toggle .moon { display: none; }
  }
  :global(:root[data-theme='dark']) .theme-toggle .sun { display: block; }
  :global(:root[data-theme='dark']) .theme-toggle .moon { display: none; }
  .lang { position: relative; }
  .lang summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: .4rem;
    border: 1px solid var(--line); border-radius: 999px; padding: .3rem .7rem;
    color: var(--text); font: 500 .8rem var(--font-mono);
  }
  .lang summary::-webkit-details-marker { display: none; }
  .lang[open] summary, .lang summary:hover { border-color: var(--link); color: var(--heading); }
  .lang ul {
    position: absolute; inset-inline-end: 0; top: calc(100% + 8px); margin: 0; padding: .4rem;
    list-style: none; min-width: 180px; max-height: 70vh; overflow: auto;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px;
    box-shadow: var(--shadow);
  }
  .lang li a { display: block; padding: .45rem .7rem; border-radius: 8px; color: var(--text); text-decoration: none; }
  .lang li a:hover { background: var(--surface); color: var(--heading); }
  .lang li a[aria-current='true'] { color: var(--link); }
  @media (max-width: 560px) {
    .home :global(.word) { display: none; }
    nav { gap: .6rem; font-size: .85rem; }
    /* En celular "Privacidad" solo va en el pie: en idiomas largos no cabe. */
    nav > a[data-page='privacy'] { display: none; }
  }
</style>
