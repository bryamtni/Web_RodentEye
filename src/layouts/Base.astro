---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, languages, langCodes, defaultLang, getDict, url, asset } from '../i18n';

interface Props {
  lang: Lang;
  /** Ruta sin idioma, ej. 'privacy'. Vacía para la portada. */
  page: string;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = getDict(lang);
const site = Astro.site!;
const abs = (l: Lang) => new URL(url(l, page), site).href;
const fullTitle = page ? `${title} · Rodent Eye` : title;
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
---
<!doctype html>
<html lang={languages[lang].hreflang} dir={languages[lang].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {page !== '404' && (
      <>
        <link rel="canonical" href={abs(lang)} />
        {langCodes.map((l) => <link rel="alternate" hreflang={languages[l].hreflang} href={abs(l)} />)}
        <link rel="alternate" hreflang="x-default" href={abs(defaultLang)} />
      </>
    )}
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <script is:inline>
      // Tema elegido con el botón del encabezado; sin elección, sigue al dispositivo.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta name="theme-color" content="#f7f9f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rodent Eye" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:image" content={new URL(asset('img/og-image.jpg'), site).href} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
  </head>
  <body>
    <a class="skip" href="#main">{t.common.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
